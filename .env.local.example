# 이 파일을 복사해서 .env.local 로 이름 바꾸고 실제 값을 채운 뒤 사용하세요.
# .env.local 은 절대 GitHub에 올리지 마세요 (.gitignore에 이미 포함됨).

# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://eoqdpldfjfjbizymapjn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에_anon_public_key_붙여넣기

# service_role key는 절대 클라이언트에 노출되지 않는 서버 전용 키입니다.
# Supabase 대시보드 > Project Settings > API > service_role 에서 확인 (공유 금지)
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_key_붙여넣기

# 로그인 세션(JWT) 서명에 쓸 임의의 긴 문자열 (아무 문자열이나 32자 이상으로 직접 생성)
SESSION_SECRET=여기에_임의의_긴_랜덤문자열_32자이상
